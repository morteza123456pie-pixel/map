<?xml version="1.0" encoding="utf-8"?>
<!--
  Fallback launcher icon for API 24-25, which predate adaptive icons. Higher API levels
  resolve mipmap-anydpi-v26 instead.

  A vector is used rather than a set of rasterised PNGs so the icon stays a single
  reviewable source file and scales to every density without extra assets. The pin is drawn
  larger than in the adaptive foreground because there is no launcher mask to allow for.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#FF00658F"
        android:pathData="M54,0 A54,54 0 1,0 54,108 A54,54 0 1,0 54,0 Z" />

    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M54,18 C41.85,18 32,27.85 32,40 C32,56.5 54,86 54,86 C54,86 76,56.5 76,40 C76,27.85 66.15,18 54,18 Z M62,40 A8,8 0 1,0 46,40 A8,8 0 1,0 62,40 Z" />

</vector>
